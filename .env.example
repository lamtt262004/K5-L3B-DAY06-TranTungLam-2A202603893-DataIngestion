# Copy to .env (never commit .env).
# local  -> BAAI/bge-small-en-v1.5 via sentence-transformers (no key, default; reported results)
# openai -> OpenAI embeddings API (needs OPENAI_API_KEY; results go to results_openai/)
EMBED_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
